{
  "name": "dsh-purge",
  "version": "1.1.88",
  "description": "Apache-2.0 red-team evaluation plugin for DeepSeek Harness (targets DSH 0.2.2-rc.1): grouped patches and swappable per-model prompts that separate host-layer blocking from model answers. 网络安全红队评测插件，可按模型替换提示词，补丁可一键还原。Forks require attribution.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "!docs/plans",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "compat:check": "node scripts/gen-compat-readme.mjs --check",
    "postinstall": "node scripts/ensure-profile-bundle.mjs",
    "test": "node --test"
  },
  "license": "Apache-2.0",
  "author": "qiuqianyi66",
  "originalAuthor": "YuJunZhiXue",
  "maintainers": [
    {
      "name": "qiuqianyi66",
      "url": "https://github.com/qiuqianyi66"
    }
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "red-team",
    "redteam",
    "security-testing",
    "prompt-injection",
    "prompt-engineering",
    "instructions",
    "rules",
    "prompt-eval",
    "llm-agent",
    "agent",
    "localhost",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiuqianyi66/dsh-purge.git"
  },
  "homepage": "https://github.com/qiuqianyi66/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/qiuqianyi66/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/qiuqianyi66/dsh-purge/tar.gz/refs/heads/main",
      "zip": "https://codeload.github.com/qiuqianyi66/dsh-purge/zip/refs/heads/main",
      "git": "https://github.com/qiuqianyi66/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.1"
}
